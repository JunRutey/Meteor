<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Transparent system bars: the app paints its own background edge-to-edge and
        MeteorRoot pads the content by WindowInsets.safeDrawing (ADR-024).
        The light-icon attributes are the startup default; MeteorTheme re-applies the
        correct icons once the (possibly user-forced) dark/light theme is known.
        windowLightNavigationBar / windowLayoutInDisplayCutoutMode are API 27 and are
        simply ignored below that (minSdk 26) — hence the NewApi suppression.
    -->
    <style name="Theme.Meteor" parent="android:Theme.Material.Light.NoActionBar" tools:ignore="NewApi">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!--
        Cold-start splash (ADR-038). The system shows the Meteor icon on a plain
        paper-coloured window while the root state (lock preference + onboarding
        gate) is still resolving; `MainActivity` releases it once the shell knows
        what it is allowed to render. The post theme is the normal app theme.

        A dedicated 1152px (288dp @xxxhdpi) transparent icon, not
        `@mipmap/ic_launcher`: the adaptive launcher foreground is only 432px and
        carries a white rounded-square background, which both blurs when the
        splash scales it up and puts a white card on the dark paper background.
        The splash icon is drawn inside the system's 192dp circle, so this
        artwork keeps its content within the safe zone. No
        `windowSplashScreenIconBackgroundColor`: the logo is transparent on
        purpose, and a solid circle behind it would only add a second disc.
    -->
    <style name="Theme.Meteor.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Meteor</item>
    </style>
</resources>
