<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Only the AI feature goes online, and only to the endpoint the user
        configured; nothing is sent unless they enable AI and accept the
        warning. See ADR-027.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".MeteorApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Meteor">

        <!--
            adjustResize is what stops the platform from panning the whole window
            when the keyboard opens (ADR-024). Edge-to-edge means the window is not
            literally resized; the IME inset is delivered to Compose instead, and
            the tree pads once at the root.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Meteor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
